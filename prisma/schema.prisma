// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

//User Model
model User {
  // Primary Key
  id String @id @default(cuid())

  // Basic Information
  name         String
  email        String @unique
  passwordHash String

  // Profile
  image String?

  // Authentication
  emailVerified      DateTime?
  isTwoFactorEnabled Boolean   @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  notes               Note[]
  accounts            Account[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  twoFactorTokens     TwoFactorToken[]

  @@index([email])
}

// Note Model
model Note {
  // Primary Key
  id String @id @default(cuid())

  // Note Information
  title   String
  content String

  // Reminder
  remindAt       DateTime?
  isReminderSent Boolean   @default(false)

  // Status
  isPinned   Boolean @default(false)
  isArchived Boolean @default(false)

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationships
  media Media[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([remindAt])
  @@index([isPinned])
  @@index([isArchived])
  @@index([createdAt])
}

// Media Model
model Media {
  // Primary Key
  id String @id @default(cuid())

  // File Information
  url      String
  type     MediaType
  publicId String    @unique

  // Ownership
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  // Timestamp
  createdAt DateTime @default(now())

  @@index([noteId])
  @@index([type])
  @@index([createdAt])
  @@index([publicId])
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
}

// Account Model
model Account {
  // Primary Key
  id String @id @default(cuid())

  // Auth.js Fields
  userId            String
  type              String
  provider          String
  providerAccountId String

  // OAuth Tokens
  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  // Relationship
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Session Model
model Session {
  // Primary Key
  id String @id @default(cuid())

  // Auth.js Fields
  sessionToken String   @unique
  expires      DateTime

  // Relationship
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// Verification Token Model
model VerificationToken {
  id String @id @default(cuid())

  email  String
  userId String

  token   String   @unique
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@index([userId])
  @@index([expires])
}

// Password Reset Token Model
model PasswordResetToken {
  id String @id @default(cuid())

  email  String
  userId String

  token   String   @unique
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@index([userId])
  @@index([expires])
}

//Two Factor Token Model
model TwoFactorToken {
  id String @id @default(cuid())

  email  String
  userId String

  token   String   @unique
  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
  @@index([userId])
  @@index([expires])
}

model PendingLogin {
  id         String   @id @default(cuid())

  email      String

  expires    DateTime

  createdAt  DateTime @default(now())

  @@unique([email])
  @@index([expires])
}